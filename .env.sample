SMTP_CONNECTION_STRING=smtp://localhost:1587
DATA_DIR_ROOT=./.tmp/data
POSTFIX_DIR_ROOT=./.tmp/development-docker-data/postfix
DOCUMENT_ROOT=/WHEREVER/feedsubscription.com/dist
NODE_ENV=development
DOMAIN_NAME=feedsubscription.com
SMTP_IN_SASL_PASSWORD=
POSTILION_SASL_PASSWORD_GURDIGA_COM=
POSTILION_SASL_PASSWORD_SANDRADODD_COM=
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=test_...
PADDLE_API_KEY=...
PADDLE_WEBHOOK_SECRET=...  # events: transaction.completed, subscription.canceled
MAKE_DEBUG=
RCLONE_PATH=
# The website (nginx) service's static IP on docker-compose.yml's own network —
# must match its networks.net.ipv4_address there (10.5.5.4 in this repo's
# compose file); api needs it to trust nginx's X-Forwarded-Proto (see server.ts).
NGINX_IP_ADDRESS=10.5.5.4
