sender_canonical_maps = tcp:127.0.0.1:10001
sender_canonical_classes = envelope_sender
recipient_canonical_maps = tcp:127.0.0.1:10002
recipient_canonical_classes = envelope_recipient,header_recipient
smtpd_tls_eccert_file =
smtpd_tls_eckey_file =
inet_protocols = ipv4
smtp_address_preference = ipv4
# NOT feedsubscription.com: smtp-out's loop detection compares the EHLO
# reply hostname (always $myhostname) against its own myhostname and
# bounces droplet-origin mail to the hosted personal domains ("mail for
# <domain> loops back to myself"). smtp_helo_name below keeps the
# outbound HELO (PTR-matching, used for SPF on bounces) unchanged.
myhostname = mx.feedsubscription.com
smtp_helo_name = feedsubscription.com
mydestination = localhost
relay_domains = feedsubscription.com, gurdiga.com, sandradodd.com
virtual_alias_maps = hash:/etc/postfix/virtual
maillog_file = /dev/stdout
# Two BDAT bugs fixed upstream in Postfix 3.7.22 are unreachable without
# CHUNKING: unbounded smtpd command history (the containers have no memory
# limit, so it reaches the droplet) and a null-pointer read from DATA after
# a BDAT error. Bookworm is frozen at 3.7.11 and the fixes carry no CVE, so
# no apt update is coming; refusing the command is the only mitigation.
# Senders that would use BDAT fall back to DATA. Drop this once the base
# image moves to a Postfix that carries the fixes.
smtpd_discard_ehlo_keywords = chunking
# Require CRLF.CRLF for end-of-data, closing the SMTP-smuggling gap that the
# 3.7 legacy release notes say is still unpatched. Not "reject", which is the
# only value that refuses the message: this is the MX for three domains, and
# rejecting strangers over a bare LF costs real delivery. In this build "yes"
# is a migration alias for "normalize", not a third behaviour.
smtpd_forbid_bare_newline = normalize
