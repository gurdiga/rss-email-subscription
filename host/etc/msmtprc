# Alerting channel that does not run through smtp-out, used by bin/notify
# and apticron-sendmail. Failures are watched by watch-msmtp.
defaults
auth           on
tls            on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile        /var/log/msmtp

account        gmail
host           smtp.gmail.com
port           587
from           res.system.notifications@gmail.com
user           res.system.notifications@gmail.com

# A Gmail app password, kept on the host so this file can be committed.
# The account exists only to send these alerts: an app password also
# opens the mailbox over IMAP, so a leak from this host exposes an
# empty one rather than the inbox the alerts go to.
passwordeval   "cat /etc/msmtp-password"

account default: gmail
