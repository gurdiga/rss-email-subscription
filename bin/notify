#!/usr/bin/env bash

# Mails an alert read from stdin. Replaces `ssmtp gurdiga@gmail.com`, which
# relayed through smtp-out — the monitoring sent its alerts with the very
# container it was watching, so a mail outage silenced the alert about it.
# msmtp talks to Gmail directly, sharing nothing with the stack: see
# /etc/msmtprc on prod, which logs every attempt to /var/log/msmtp.

set -euo pipefail

recipient="${NOTIFY_TO:-gurdiga@gmail.com}"

# Injection seam: tests point this at a stub rather than mailing anything.
msmtp="${NOTIFY_MSMTP:-msmtp}"

# Gmail rewrites the From header to the authenticated account, so alerts
# cannot be filtered by sender. This is the handle that survives:
# list:(res-alerts.feedsubscription.com). Sub-addressing does not work —
# deliveredto: matches nothing.
list_id='RES alerts <res-alerts.feedsubscription.com>'

# Alerts used to arrive with no Message-ID at all — postfix logged
# `message-id=<>` — and Gmail grouped them by subject. Sending through
# Gmail's own submission service mints a unique Message-ID per message,
# which ends the grouping. Pointing every alert with the same subject at
# one synthetic parent restores it, and does not depend on the heuristic.
# The parent need not exist. A subject carrying a timestamp threads alone,
# exactly as it did before.
thread_id_for() {
  local subject slug

  subject=$(sed -n 's/^Subject: *//p' <<<"$1" | head -1)
  slug=$(tr '[:upper:]' '[:lower:]' <<<"$subject" | tr -cs '[:alnum:]' '-' | sed 's/^-*//; s/-*$//')

  printf '%s@feedsubscription.com' "${slug:-res-alert}"
}

main() {
  if [ -t 1 ] || [ -n "${MAKE_DEBUG:-}" ]; then
    exec cat
  fi

  local message
  message=$(cat)

  # Replaces `ifne`, slightly more strictly: whitespace-only counts as
  # nothing to report, where ifne would have mailed a lone newline.
  [[ $message =~ [^[:space:]] ]] || exit 0

  local thread
  thread=$(thread_id_for "$message")

  # Headers first: callers emit their own Subject and From, and these have
  # to land in the same block. Without To the recipient is only an envelope
  # address, which makes Gmail stamp the delivered copy Bcc. Flush left
  # because this is not <<-; $message expands once, so a $ in a log line is
  # not re-expanded.
  local mail
  mail=$(cat <<EOF
List-Id: $list_id
To: $recipient
In-Reply-To: <$thread>
References: <$thread>
$message
EOF
  )

  if ! "$msmtp" "$recipient" <<<"$mail"; then
    # Nothing catches this: the crontab sets MAILTO="", so cron discards
    # what a job writes to stderr. The alert is lost, and the only record
    # is msmtp's own line in /var/log/msmtp. Echo it anyway for the
    # interactive case.
    echo "notify: msmtp failed, alert not delivered:" >&2
    printf '%s\n' "$message" >&2
    exit 1
  fi
}

main "$@"
